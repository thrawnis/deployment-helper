# ── Deployment Dashboard — environment config ─────────────────────────────
#
# Copy this file to .env and set at least ADMIN_PASSWORD.

# Password required to open the admin panel (⚙ Manage) and edit project
# configuration. No password is needed to view the dashboard or run deploys.
ADMIN_PASSWORD=changeme

# ── Legacy project config (optional) ───────────────────────────────────────
#
# Projects are now managed from the web UI (⚙ Manage → Add Project) and
# stored in ./data/projects.json. The PROJECT_N_* vars below are only read
# once, the very first time the app starts with no ./data/projects.json
# present, to seed the initial project list. After that they are ignored —
# edit projects from the UI instead.

# PROJECT_1_NAME=Money Tracker
# PROJECT_1_PATH=/media/docker/money-tracker
# PROJECT_1_SCRIPT=./rebuild.sh
